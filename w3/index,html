<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BeatMeme Studio - 音樂風迷因產生器</title>

    <!-- 1. Google Fonts 引入: Orbitron (科技音樂字體)、Montserrat (簡約內文)、Anton (經典迷因粗體) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Montserrat:wght@400;600;700;800&family=Orbitron:wght@600;800;900&display=swap" rel="stylesheet">

    <!-- 2. FontAwesome 圖示庫 (用於音樂按鈕與圖示) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- 3. Tailwind CSS (快速刻劃現代化 UI) -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- 4. html2canvas CDN (將網頁 DOM 區塊轉為圖片下載) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <style>
        /* 全域視覺設定：暗色調音樂工作室風格 */
        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #0b0d14;
            color: #f3f4f6;
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(236, 72, 153, 0.12) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(6, 182, 212, 0.12) 0%, transparent 40%);
            min-height: 100vh;
        }

        .font-orbitron {
            font-family: 'Orbitron', sans-serif;
        }

        /* 經典迷因文字：Anton 粗體搭配黑重陰影與粗邊框，確保任何底圖上都清晰 */
        .meme-text {
            font-family: 'Anton', 'Impact', sans-serif;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: #ffffff;
            /* 360 度描邊與描影 */
            text-shadow: 
                3px 3px 0 #000, -3px -3px 0 #000, 
                3px -3px 0 #000, -3px 3px 0 #000,
                0px 4px 0 #000, 0px -4px 0 #000, 
                4px 0px 0 #000, -4px 0px 0 #000,
                0px 10px 20px rgba(0,0,0,0.85);
            user-select: none;
            word-wrap: break-word;
            line-height: 1.15;
            -webkit-text-stroke: 1.5px black;
        }

        /* DJ 混音主控台玻璃擬態卡片 (Glassmorphism) */
        .synth-card {
            background: rgba(18, 22, 33, 0.85);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
        }

        /* 音響推桿 / 等化器 (Equalizer Slider) 自訂樣式 */
        input[type=range] {
            -webkit-appearance: none;
            background: #151a26;
            height: 10px;
            border-radius: 5px;
            outline: none;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        input[type=range]::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 22px;
            height: 26px;
            border-radius: 6px;
            background: linear-gradient(135deg, #06b6d4, #ec4899);
            cursor: pointer;
            box-shadow: 0 0 12px rgba(236, 72, 153, 0.8);
            border: 1px solid #ffffff;
            transition: transform 0.1s ease;
        }

        input[type=range]::-webkit-slider-thumb:hover {
            transform: scale(1.1);
        }

        /* 呼吸燈效果 */
        @keyframes neonGlow {
            0%, 100% { box-shadow: 0 0 15px rgba(6, 182, 212, 0.4); }
            50% { box-shadow: 0 0 25px rgba(236, 72, 153, 0.6); }
        }

        .neon-pulse {
            animation: neonGlow 4s infinite ease-in-out;
        }
    </style>
</head>
<body class="p-4 md:p-8 flex flex-col justify-between items-center min-h-screen">

    <!-- 頁頭：電音科技風 Header -->
    <header class="w-full max-w-6xl text-center mb-6">
        <div class="inline-flex items-center gap-2 bg-slate-900/80 px-4 py-1.5 rounded-full border border-cyan-500/30 mb-3 shadow-lg">
            <i class="fa-solid fa-compact-disc text-cyan-400 animate-spin" style="animation-duration: 5s;"></i>
            <span class="text-xs uppercase tracking-widest text-cyan-300 font-semibold font-orbitron">BEATMEME STUDIO v2.0</span>
        </div>
        <h1 class="font-orbitron text-3xl md:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-fuchsia-400 to-pink-500 tracking-wider">
            音樂風迷因產生器
        </h1>
        <p class="text-gray-400 text-xs md:text-sm mt-1">混合你的幽默節奏 ・ 輕鬆輸出專屬專輯封面迷因</p>
    </header>

    <!-- 主工作區：兩欄響應式佈局 (左側為控制混音台，右側為迷因預覽區) -->
    <main class="w-full max-w-6xl grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

        <!-- ==================== 左區：DJ 混音調音面板 (6 欄) ==================== -->
        <section class="lg:col-span-6 synth-card p-6 rounded-2xl flex flex-col gap-6 relative border border-slate-800">
            
            <!-- 調音台頂部燈條裝飾 -->
            <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                <div class="flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-red-500 inline-block animate-pulse"></span>
                    <span class="w-3 h-3 rounded-full bg-yellow-500 inline-block"></span>
                    <span class="w-3 h-3 rounded-full bg-green-500 inline-block"></span>
                    <span class="text-xs font-mono text-gray-400 ml-2">MASTER_DECK: ONLINE</span>
                </div>
                <div class="text-xs font-mono text-cyan-400 flex items-center gap-1 font-semibold">
                    <i class="fa-solid fa-sliders"></i> EQ CONTROL
                </div>
            </div>

            <!-- 控制項 1: 本機圖片上傳區塊 (使用 FileReader 防範 CORS 跨域錯誤) -->
            <div class="flex flex-col gap-2">
                <label class="text-xs font-bold uppercase tracking-wider text-cyan-400 flex items-center gap-2">
                    <i class="fa-solid fa-file-audio"></i> 1. 上傳迷因底圖 (AUDIO SOURCE)
                </label>
                <div class="relative group">
                    <!-- 隱藏原生檔案選擇器 -->
                    <input type="file" id="imageInput" accept="image/*" class="hidden">
                    <!-- 自訂漂亮的上傳按鈕 -->
                    <button type="button" onclick="document.getElementById('imageInput').click()" 
                            class="w-full py-3.5 px-4 rounded-xl border-2 border-dashed border-cyan-500/40 bg-cyan-950/20 hover:bg-cyan-900/30 hover:border-cyan-400 transition-all flex items-center justify-center gap-3 text-cyan-300 font-semibold text-sm group-hover:scale-[1.01]">
                        <i class="fa-solid fa-cloud-arrow-up text-lg"></i>
                        <span id="uploadBtnText">選擇本機圖片 (避免 CORS 錯誤)</span>
                    </button>
                </div>
            </div>

            <!-- 控制項 2: 上下文輸入框 -->
            <div class="space-y-4">
                <div>
                    <label for="topTextInput" class="text-xs font-bold uppercase tracking-wider text-pink-400 flex items-center gap-2 mb-1.5">
                        <i class="fa-solid fa-font"></i> 2. 上方文字 (HIGH EQ)
                    </label>
                    <input type="text" id="topTextInput" placeholder="輸入上方文字..." value="當音樂節奏對的時候" 
                           class="w-full bg-slate-900/90 border border-slate-700 focus:border-pink-500 focus:ring-1 focus:ring-pink-500 rounded-xl px-4 py-2.5 text-white placeholder-gray-500 outline-none transition-all font-medium">
                </div>

                <div>
                    <label for="bottomTextInput" class="text-xs font-bold uppercase tracking-wider text-pink-400 flex items-center gap-2 mb-1.5">
                        <i class="fa-solid fa-font"></i> 3. 下方文字 (LOW EQ)
                    </label>
                    <input type="text" id="bottomTextInput" placeholder="輸入下方文字..." value="全場我最酷！" 
                           class="w-full bg-slate-900/90 border border-slate-700 focus:border-pink-500 focus:ring-1 focus:ring-pink-500 rounded-xl px-4 py-2.5 text-white placeholder-gray-500 outline-none transition-all font-medium">
                </div>
            </div>

            <!-- 控制項 3: 等化器調音滑桿 (Font Size, Top Position, Bottom Position) -->
            <div class="bg-slate-900/60 p-4 rounded-xl border border-slate-800/80 space-y-4">
                <div class="text-xs font-bold uppercase tracking-wider text-purple-400 flex items-center justify-between">
                    <span class="flex items-center gap-2"><i class="fa-solid fa-sliders"></i> 4. 文字參數調節 (SLIDERS)</span>
                    <span class="text-[10px] bg-purple-900/50 text-purple-300 px-2 py-0.5 rounded border border-purple-500/30 font-mono">REAL-TIME</span>
                </div>

                <!-- 滑桿 A: 字體大小 -->
                <div class="space-y-1">
                    <div class="flex justify-between text-xs font-mono text-gray-300">
                        <span>FONT SIZE (字體大小)</span>
                        <span id="fontSizeValue" class="text-cyan-400 font-bold">42 px</span>
                    </div>
                    <input type="range" id="fontSizeSlider" min="20" max="80" value="42" class="w-full">
                </div>

                <!-- 滑桿 B: 上方文字垂直位置 -->
                <div class="space-y-1">
                    <div class="flex justify-between text-xs font-mono text-gray-300">
                        <span>TOP POS (上方文字高度)</span>
                        <span id="topPosValue" class="text-pink-400 font-bold">10 %</span>
                    </div>
                    <input type="range" id="topPosSlider" min="2" max="45" value="10" class="w-full">
                </div>

                <!-- 滑桿 C: 下方文字垂直位置 -->
                <div class="space-y-1">
                    <div class="flex justify-between text-xs font-mono text-gray-300">
                        <span>BOTTOM POS (下方文字高度)</span>
                        <span id="bottomPosValue" class="text-pink-400 font-bold">10 %</span>
                    </div>
                    <input type="range" id="bottomPosSlider" min="2" max="45" value="10" class="w-full">
                </div>
            </div>

            <!-- 控制項 4: 一鍵下載圖檔按鈕 -->
            <button id="downloadBtn" 
                    class="w-full py-4 rounded-xl bg-gradient-to-r from-cyan-500 via-purple-600 to-pink-500 hover:from-cyan-400 hover:via-purple-500 hover:to-pink-400 text-white font-black font-orbitron tracking-wider shadow-lg shadow-pink-500/20 active:scale-[0.98] transition-all flex items-center justify-center gap-3 text-lg border border-white/20">
                <i class="fa-solid fa-download animate-bounce"></i>
                EXPORT MEME (.PNG)
            </button>
        </section>


        <!-- ==================== 右區：迷因唱片預覽區塊 (6 欄) ==================== -->
        <section class="lg:col-span-6 flex flex-col items-center justify-center w-full">
            <div class="synth-card p-4 md:p-6 rounded-2xl w-full flex flex-col items-center border border-slate-800 neon-pulse">
                
                <!-- 頂部模擬黑膠唱片 Header -->
                <div class="w-full flex justify-between items-center mb-4 px-2">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-record-vinyl text-pink-500 text-xl animate-spin" style="animation-duration: 8s;"></i>
                        <span class="font-orbitron text-xs md:text-sm font-bold tracking-wide text-gray-200">ALBUM COVER PREVIEW</span>
                    </div>
                    <span class="text-xs font-mono bg-cyan-950 text-cyan-400 px-2.5 py-1 rounded-md border border-cyan-800/80">LIVE CANVAS</span>
                </div>

                <!-- 關鍵容器：html2canvas 會捕捉此區域並導出為圖片 -->
                <div id="memeContainer" class="relative w-full aspect-square bg-slate-950 rounded-xl overflow-hidden shadow-2xl flex items-center justify-center border border-slate-800">
                    
                    <!-- 底圖 (Image Element) -->
                    <img id="memeImage" src="" alt="Meme Background" class="w-full h-full object-cover select-none">

                    <!-- 上方文字圖層 (Top Text Layer) -->
                    <div id="memeTopText" class="absolute w-full px-4 text-center meme-text leading-tight uppercase transition-all pointer-events-none" style="top: 10%;">
                        當音樂節奏對的時候
                    </div>

                    <!-- 下方文字圖層 (Bottom Text Layer) -->
                    <div id="memeBottomText" class="absolute w-full px-4 text-center meme-text leading-tight uppercase transition-all pointer-events-none" style="bottom: 10%;">
                        全場我最酷！
                    </div>
                </div>

                <!-- 模擬音樂播放器面板 -->
                <div class="w-full mt-4 bg-slate-900/90 rounded-xl p-3 border border-slate-800 flex items-center gap-4">
                    <div class="w-10 h-10 rounded-full bg-cyan-500/20 text-cyan-400 flex items-center justify-center shrink-0">
                        <i class="fa-solid fa-play text-sm ml-0.5"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex justify-between text-[11px] font-mono text-gray-400 mb-1">
                            <span class="truncate">TRACK_01_MY_MEME.WAV</span>
                            <span>44.1 kHz</span>
                        </div>
                        <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden">
                            <div class="bg-gradient-to-r from-cyan-400 to-pink-500 h-full w-2/3 rounded-full"></div>
                        </div>
                    </div>
                </div>

            </div>
        </section>

    </main>

    <!-- 頁尾宣告 -->
    <footer class="mt-8 text-center text-xs font-mono text-gray-500">
        BEAT MEME MIXER &copy; 2026 - HTML2CANVAS & TAILWIND POWERED
    </footer>


    <!-- ==================== JavaScript 核心邏輯 ==================== -->
    <script>
        // 【1. 取得 DOM 網頁元素】
        const imageInput = document.getElementById('imageInput');
        const memeImage = document.getElementById('memeImage');
        const memeContainer = document.getElementById('memeContainer');
        const uploadBtnText = document.getElementById('uploadBtnText');

        const topTextInput = document.getElementById('topTextInput');
        const bottomTextInput = document.getElementById('bottomTextInput');
        const memeTopText = document.getElementById('memeTopText');
        const memeBottomText = document.getElementById('memeBottomText');

        const fontSizeSlider = document.getElementById('fontSizeSlider');
        const topPosSlider = document.getElementById('topPosSlider');
        const bottomPosSlider = document.getElementById('bottomPosSlider');

        const fontSizeValue = document.getElementById('fontSizeValue');
        const topPosValue = document.getElementById('topPosValue');
        const bottomPosValue = document.getElementById('bottomPosValue');

        const downloadBtn = document.getElementById('downloadBtn');

        // 【2. 生成預設音樂唱片圖 (使用 Canvas 本機繪製，確保完全不觸發 CORS 問題)】
        function createDefaultMusicImage() {
            const canvas = document.createElement('canvas');
            canvas.width = 600;
            canvas.height = 600;
            const ctx = canvas.getContext('2d');

            // 繪製漸層背景
            const gradient = ctx.createRadialGradient(300, 300, 40, 300, 300, 350);
            gradient.addColorStop(0, '#2e1065');
            gradient.addColorStop(0.5, '#0f172a');
            gradient.addColorStop(1, '#020617');
            ctx.fillStyle = gradient;
            ctx.fillRect(0, 0, 600, 600);

            // 繪製霓虹外環
            ctx.beginPath();
            ctx.arc(300, 300, 180, 0, Math.PI * 2);
            ctx.strokeStyle = '#06b6d4';
            ctx.lineWidth = 8;
            ctx.shadowColor = '#06b6d4';
            ctx.shadowBlur = 20;
            ctx.stroke();

            // 繪製內側粉色環
            ctx.beginPath();
            ctx.arc(300, 300, 100, 0, Math.PI * 2);
            ctx.strokeStyle = '#ec4899';
            ctx.lineWidth = 6;
            ctx.shadowColor = '#ec4899';
            ctx.shadowBlur = 15;
            ctx.stroke();

            // 中央圖示 Emoji
            ctx.shadowBlur = 0;
            ctx.font = 'bold 90px "Segoe UI Emoji", sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText('🎧', 300, 300);

            // 轉成 Data URL 賦予給圖片
            memeImage.src = canvas.toDataURL('image/png');
        }

        // 【3. 本機圖片上傳 (使用 FileReader 轉為 DataURL，避開 CORS 跨域限制)】
        imageInput.addEventListener('change', function(event) {
            const file = event.target.files[0];

            if (file) {
                // 檢查是否為圖片檔案
                if (!file.type.startsWith('image/')) {
                    alert('請選擇圖片格式檔案！');
                    return;
                }

                // 建立 FileReader 讀取本機檔案
                const reader = new FileReader();

                // 讀取成功後替換底圖 src
                reader.onload = function(e) {
                    memeImage.src = e.target.result;
                    uploadBtnText.textContent = `已載入: ${file.name}`;
                };

                // 將圖片檔案轉換為 Base64 格式
                reader.readAsDataURL(file);
            }
        });

        // 【4. 即時連動：輸入文字連動更新預覽】
        topTextInput.addEventListener('input', function() {
            memeTopText.textContent = this.value || '';
        });

        bottomTextInput.addEventListener('input', function() {
            memeBottomText.textContent = this.value || '';
        });

        // 【5. 即時連動：滑桿控制字體大小與垂直位置】
        function updateStyles() {
            // A. 字體大小
            const size = fontSizeSlider.value;
            memeTopText.style.fontSize = `${size}px`;
            memeBottomText.style.fontSize = `${size}px`;
            fontSizeValue.textContent = `${size} px`;

            // B. 上方文字高度
            const topPos = topPosSlider.value;
            memeTopText.style.top = `${topPos}%`;
            topPosValue.textContent = `${topPos} %`;

            // C. 下方文字高度
            const bottomPos = bottomPosSlider.value;
            memeBottomText.style.bottom = `${bottomPos}%`;
            bottomPosValue.textContent = `${bottomPos} %`;
        }

        // 為所有滑桿註冊監聽事件
        fontSizeSlider.addEventListener('input', updateStyles);
        topPosSlider.addEventListener('input', updateStyles);
        bottomPosSlider.addEventListener('input', updateStyles);

        // 【6. 一鍵下載圖檔：使用 html2canvas 擷取畫面並下載】
        downloadBtn.addEventListener('click', function() {
            // 變更按鈕為處理中狀態
            const originalBtnHTML = downloadBtn.innerHTML;
            downloadBtn.innerHTML = `<i class="fa-solid fa-spinner animate-spin"></i> GENERATING...`;
            downloadBtn.disabled = true;

            // 呼叫 html2canvas 捕捉 #memeContainer 內容
            html2canvas(memeContainer, {
                useCORS: true,        // 允許跨域圖片
                scale: 2,             // 雙倍清晰度輸出 (High DPI)
                backgroundColor: null // 保持透明/預設背景
            }).then(canvas => {
                // 建立隱藏的 <a> 標籤進行下載操作
                const link = document.createElement('a');
                link.download = 'my-meme.png';
                link.href = canvas.toDataURL('image/png');
                
                // 觸發下載
                link.click();
